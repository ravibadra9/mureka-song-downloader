{
  "manifest_version": 3,
  "name": "Mureka Song Downloader - All Workspaces",
  "version": "1.0.1",
  "description": "Download songs from all workspaces in your Mureka.ai account in MP3 or Lossless WAV with organized workspace folders, batch ZIP export, and Python tool integration.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "downloads",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.mureka.ai/*",
    "http://127.0.0.1:59966/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mureka Song Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mureka.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "icons/*",
        "popup.html"
      ],
      "matches": [
        "*://*.mureka.ai/*"
      ]
    }
  ]
}